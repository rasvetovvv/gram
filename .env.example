# Public browser URL for the local FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL. Replace all values before any non-local deployment.
POSTGRES_DB=gram
POSTGRES_USER=gram
POSTGRES_PASSWORD=gram

# Authentication. Generate a long random secret outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
ENABLE_DEMO_TOPUPS=true

# Seeded local account.
DEMO_EMAIL=leon@gram.local
DEMO_USERNAME=leon
DEMO_PASSWORD=GramDemo!2026
