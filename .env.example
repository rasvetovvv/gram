# Canonical public browser/API origin.
NEXT_PUBLIC_API_URL=https://vexory.xyz
NEXT_PUBLIC_GRAM_WIRE_ENABLED=false
NEXT_PUBLIC_GRAM_WIRE_PRIMARY=false
NEXT_PUBLIC_GRAM_WIRE_CANARY_ONLY=true
NEXT_PUBLIC_GRAM_WIRE_URL=wss://vexory.xyz/wire
NEXT_PUBLIC_GRAM_WIRE_IDENTITY_PUBLIC_KEY_B64=
# Optional: previously-trusted Ed25519 gateway pins during a key rotation (comma-separated,
# base64). The browser accepts a handshake signed by the primary pin above OR any pin here, so
# a client on an old bundle keeps working while the gateway serves a rotated identity.
NEXT_PUBLIC_GRAM_WIRE_IDENTITY_PUBLIC_KEYS_B64=

# PostgreSQL. Replace all values before any non-local deployment.
POSTGRES_DB=gram
POSTGRES_USER=gram
POSTGRES_PASSWORD=gram

# Authentication. Generate a long random secret outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
# GRAM Wire uses a separate ticket key and a persistent Ed25519 identity. Never reuse JWT_SECRET.
# Generate both once, store with the production secrets, and pin the derived public key in clients.
WIRE_TICKET_SECRET=replace-with-a-different-32-byte-random-secret
WIRE_INTERNAL_SECRET=replace-with-another-independent-32-byte-secret
WIRE_IDENTITY_PRIVATE_KEY_B64=replace-with-base64-ed25519-private-key
# Optional protected Prometheus endpoint. Keep empty to make /metrics return 403.
WIRE_METRICS_TOKEN=
WIRE_TICKET_TTL_SECONDS=60
WIRE_OUTBOX_ENABLED=false
WIRE_ALLOWED_ORIGINS=https://vexory.xyz,https://www.vexory.xyz
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true
ENABLE_INTERNAL_LEDGER_TOPUPS=false
# Whether stars may be taken out of the site. Off until somebody is there to send the Telegram half
# of a payout by hand — the button says so instead of queueing requests nobody can settle. Reading
# and cancelling existing requests works either way.
STAR_PAYOUTS_ENABLED=false

# Seeded local account.
DEMO_EMAIL=leon@gram.local
DEMO_USERNAME=leon
DEMO_PASSWORD=GramDemo!2026

# Telegram Stars checkout. Site stars are bought inside our own bot: the API mints an order, the
# bot charges for it in Telegram Stars and reports the charge back with this shared secret.
# The username is what the deep link is built from — a wrong one sends buyers to another bot.
TELEGRAM_BOT_USERNAME=vexoryxyzbot
BOT_API_SECRET=replace-with-a-long-random-string
# Only the bot process needs the token; the API never talks to Telegram.
TELEGRAM_BOT_TOKEN=
GRAM_SITE_URL=https://vexory.xyz
# Who decides refunds, by Telegram id. The bot only trusts these ids on its buttons.
TELEGRAM_ADMIN_ID=944763501
# How long after a payment a refund may be asked for.
REFUND_WINDOW_DAYS=14

# Email confirmation and login OTP (production: Mailcow SMTP with STARTTLS).
SITE_PUBLIC_URL=https://vexory.xyz
EMAIL_AUTH_ENABLED=true
EMAIL_OTP_BYPASS=false
EMAIL_OTP_SECRET=replace-with-at-least-64-random-characters
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_SENDS=5
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM=GRAM <no-reply@example.com>
SMTP_SSL=0
SMTP_TLS=1
