.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.DS_Store
Thumbs.db
*.log
.coverage
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
web/node_modules/
web/.next/
web/out/
.impeccable/live/
# Junction-linked scratch copy of web/, so a second dev server can run while another
# session holds web/'s own Next lock. Shares src/ and node_modules/ with the real app.
.preview/

# Local reference-inspection helpers and their captures, at the repo root only. `api/tools/`
# holds committed operational scripts, and Ruff is configured to lint `tools/**`, so an
# unanchored pattern here silently excluded scripts the project expects to have.
/tools/

# Dependencies installed at the repo root (the app's own live under web/)
/node_modules/

# Runtime state and scratch, all of it regenerable
.playwright-mcp/
.claude-flow/
.claude/
.impeccable/

# Local UI reference-screenshot captures, kept out of the repo entirely.
/createaccref/
/editaccref/
/newref/
/premiumref/
/refer/
/giftbuyref/
/authref/
/tgnftsref/
# Uploads and the gift-artwork cache: written at runtime, fetched again when missing
api/media/

# TypeScript incremental build state, rewritten on every typecheck
web/tsconfig.tsbuildinfo
# Throwaway database for browser probes when the docker stack is down.
api/probe.db

# Production database exports contain private account and ledger data.
/backup.sql

# Runtime secret material and rollback dumps are provisioned on the server and never committed.
/secrets/
/.rollback/
